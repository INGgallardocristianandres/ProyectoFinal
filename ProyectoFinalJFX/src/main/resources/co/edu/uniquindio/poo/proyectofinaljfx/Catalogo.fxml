<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" style="-fx-background-color: linear-gradient(to top,#F8FAFC,#AAD2F9);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinaljfx.viewController.CatalogoController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="86.0" spacing="16.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);">
         <children>
            <Label text="Catalogo de inmuebles"><font><Font name="System Bold" size="26.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#volver" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Volver" />
         </children>
         <padding><Insets left="32.0" right="32.0" /></padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);">
         <children>
            <GridPane hgap="12.0" vgap="10.0">
               <children>
                  <TextField fx:id="txtCiudad" promptText="Ciudad" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbTipoInmueble" promptText="Tipo inmueble" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <ComboBox fx:id="cbTipoOferta" promptText="Tipo oferta" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                  <TextField fx:id="txtPrecioMinimo" promptText="Precio minimo" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                  <TextField fx:id="txtPrecioMaximo" promptText="Precio maximo" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                  <TextField fx:id="txtAreaMinima" promptText="Area minima" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                  <Button mnemonicParsing="false" onAction="#buscar" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Buscar" GridPane.columnIndex="6" GridPane.rowIndex="0" />
                  <Button mnemonicParsing="false" onAction="#limpiarFiltros" style="-fx-background-color: #E5E7EB; -fx-text-fill: #111827; -fx-background-radius: 8;" text="Limpiar" GridPane.columnIndex="7" GridPane.rowIndex="0" />
               </children>
            </GridPane>
            <SplitPane dividerPositions="0.68">
               <items>
                  <TableView fx:id="tblCatalogo" prefHeight="480.0">
                     <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Codigo" />
                        <TableColumn fx:id="colNombre" prefWidth="170.0" text="Nombre" />
                        <TableColumn fx:id="colCiudad" prefWidth="120.0" text="Ciudad" />
                        <TableColumn fx:id="colTipo" prefWidth="115.0" text="Tipo" />
                        <TableColumn fx:id="colOferta" prefWidth="105.0" text="Oferta" />
                        <TableColumn fx:id="colValor" prefWidth="120.0" text="Valor" />
                        <TableColumn fx:id="colArea" prefWidth="90.0" text="Area" />
                     </columns>
                  </TableView>
                  <TextArea fx:id="txtDetalle" editable="false" prefWidth="300.0" wrapText="true" />
               </items>
            </SplitPane>
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#agregarFavorito" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Agregar favorito" />
                  <Button mnemonicParsing="false" onAction="#realizarOferta" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Realizar oferta" />
               </children>
            </HBox>
         </children>
         <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
         <BorderPane.margin><Insets bottom="34.0" left="38.0" right="38.0" top="34.0" /></BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
