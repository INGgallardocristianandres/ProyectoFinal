<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to top,#F8FAFC,#AAD2F9);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinaljfx.viewController.RegistrarTransaccionController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="86.0" spacing="16.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);">
         <children>
            <Label text="Registrar transaccion"><font><Font name="System Bold" size="26.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#volver" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Volver" />
         </children>
         <padding><Insets left="32.0" right="32.0" /></padding>
      </HBox>
   </top>
   <center>
      <VBox spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);">
         <children>
            <GridPane hgap="16.0" vgap="16.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="32.0" />
                  <ColumnConstraints percentWidth="68.0" />
               </columnConstraints>
               <children>
                  <Label text="Inmueble" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  <Label fx:id="lblInmueble" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  <Label text="Comprador" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  <Label fx:id="lblComprador" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Monto final" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  <Label fx:id="lblMonto" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Operacion" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  <Label fx:id="lblTipoOperacion" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Metodo de pago" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                  <ComboBox fx:id="cbMetodoPago" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="Comision inmobiliaria" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                  <TextField fx:id="txtComision" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               </children>
            </GridPane>
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Button mnemonicParsing="false" onAction="#confirmar" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Confirmar transaccion" />
               </children>
            </HBox>
         </children>
         <padding><Insets bottom="32.0" left="38.0" right="38.0" top="38.0" /></padding>
         <BorderPane.margin><Insets bottom="52.0" left="90.0" right="90.0" top="52.0" /></BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
