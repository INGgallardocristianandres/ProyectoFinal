<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1050.0" style="-fx-background-color: linear-gradient(to top,#F8FAFC,#AAD2F9);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.proyectofinaljfx.viewController.OfertasCompradorController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="86.0" spacing="16.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 2);">
         <children>
            <Label text="Mis ofertas"><font><Font name="System Bold" size="26.0" /></font></Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#refrescar" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Refrescar" />
            <Button mnemonicParsing="false" onAction="#volver" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;" text="Volver" />
         </children>
         <padding><Insets left="32.0" right="32.0" /></padding>
      </HBox>
   </top>
   <center>
      <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);">
         <children>
            <TableView fx:id="tblOfertas" prefHeight="520.0">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="240.0" text="ID" />
                  <TableColumn fx:id="colInmueble" prefWidth="220.0" text="Inmueble" />
                  <TableColumn fx:id="colMonto" prefWidth="140.0" text="Monto" />
                  <TableColumn fx:id="colFecha" prefWidth="140.0" text="Fecha" />
                  <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
               </columns>
            </TableView>
         </children>
         <padding><Insets bottom="22.0" left="22.0" right="22.0" top="22.0" /></padding>
         <BorderPane.margin><Insets bottom="42.0" left="52.0" right="52.0" top="42.0" /></BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
